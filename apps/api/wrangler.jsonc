{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fllooat",
  // Cloudflare アカウント mofumofupop。複数のアカウントにログインしていても、ここにだけデプロイされる。
  "account_id": "211e40aecb7e11abd3a8ba4db1225106",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // デプロイすると、mfmf.moe のゾーンに DNS レコードと証明書が自動で作られる。
  "routes": [{ "pattern": "fllooat.mfmf.moe", "custom_domain": true }],
  // apps/web のビルド結果を同じ Worker から配信するので、CORS の設定は不要。
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // 最後に画面を開いてからこの分数が過ぎた人を、離れている (isAway) とみなす。
    "AWAY_THRESHOLD_MINUTES": "180"
  },
  // 値はローカルでは .dev.vars、本番では `wrangler secret put <NAME>` で設定する。
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET"
    ]
  },
  // ルーム ID の総当たりを遅くするため、入室の回数をユーザーごとに制限する。
  "ratelimits": [
    { "name": "JOIN_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fllooat-db",
      "database_id": "9b8ac1c7-59bd-404d-97a4-d0bda957054b",
      "migrations_dir": "drizzle"
    }
  ]
}
