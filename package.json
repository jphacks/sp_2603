{
  "name": "fllooat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "dev:web": "pnpm --filter @fllooat/web dev",
    "dev:mock": "pnpm --filter @fllooat/web dev:mock",
    "dev:api": "pnpm --filter @fllooat/api dev",
    "gen": "pnpm --filter @fllooat/api gen:openapi && pnpm --filter @fllooat/api-client gen",
    "check": "biome check --write .",
    "lint": "biome ci .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @fllooat/web build",
    "db:generate": "pnpm --filter @fllooat/api db:generate",
    "db:migrate:local": "pnpm --filter @fllooat/api db:migrate:local",
    "db:seed:local": "pnpm --filter @fllooat/api db:seed:local",
    "db:migrate:remote": "pnpm --filter @fllooat/api db:migrate:remote",
    "cf:deploy": "pnpm build && pnpm --filter @fllooat/api run deploy",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2"
  }
}
