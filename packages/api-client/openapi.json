{
  "openapi": "3.1.0",
  "info": {
    "title": "Fllooat API",
    "version": "0.0.0"
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      }
    },
    "schemas": {
      "Healthz": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "u_abc"
              },
              "name": {
                "type": "string",
                "example": "Alice"
              },
              "image": {
                "type": [
                  "string",
                  "null"
                ],
                "example": "https://example.com/alice.png"
              }
            },
            "required": [
              "id",
              "name",
              "image"
            ]
          },
          "roomId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{6}$",
            "description": "ルームに入っていなければ null",
            "example": "012345"
          }
        },
        "required": [
          "user",
          "roomId"
        ]
      },
      "ApiErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "UNAUTHORIZED",
              "NOT_ROOM_MEMBER",
              "ROOM_NOT_FOUND",
              "MEMBER_NOT_FOUND",
              "TASK_NOT_FOUND",
              "WEIGHT_LIMIT_EXCEEDED",
              "RATE_LIMITED",
              "ROOM_ID_EXHAUSTED"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "$ref": "#/components/schemas/ErrorDetails"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorDetails": {
        "type": "object",
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            }
          },
          "remaining": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        }
      },
      "ValidationIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ]
      },
      "MyStatus": {
        "type": "object",
        "properties": {
          "busy": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "忙しさ。乗っているタスクの重さの合計 (%)",
            "example": 60
          },
          "remaining": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "あと何 % まで乗せられるか",
            "example": 40
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "description": "気球に乗っているタスク。乗せた日時の新しい順"
          },
          "pool": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PoolTask"
            },
            "description": "プールにあるタスク。作った日時の新しい順"
          }
        },
        "required": [
          "busy",
          "remaining",
          "tasks",
          "pool"
        ]
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 12
          },
          "title": {
            "type": "string",
            "example": "API の実装"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "タスクの重さ (%)",
            "example": 30
          },
          "loadedAt": {
            "type": "string",
            "format": "date-time",
            "description": "気球に乗せた日時"
          }
        },
        "required": [
          "id",
          "title",
          "weight",
          "loadedAt"
        ]
      },
      "PoolTask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 12
          },
          "title": {
            "type": "string",
            "example": "API の実装"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "タスクの重さ (%)",
            "example": 30
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "プールに作った日時"
          }
        },
        "required": [
          "id",
          "title",
          "weight",
          "createdAt"
        ]
      },
      "NewTask": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "example": "API の実装"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "タスクの重さ (%)",
            "example": 30
          }
        },
        "required": [
          "title",
          "weight"
        ]
      },
      "JoinedRoom": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "6 桁のルーム ID (000000 から 999999)。先頭の 0 を落とさないよう文字列で持つ",
            "example": "012345"
          }
        },
        "required": [
          "roomId"
        ]
      },
      "Room": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "6 桁のルーム ID (000000 から 999999)。先頭の 0 を落とさないよう文字列で持つ",
            "example": "012345"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomMember"
            },
            "description": "メンバー。自分を含めて入室順"
          }
        },
        "required": [
          "roomId",
          "members"
        ]
      },
      "RoomMember": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "example": "u_abc"
          },
          "name": {
            "type": "string",
            "example": "Alice"
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "example": "https://example.com/alice.png"
          },
          "busy": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "忙しさ。乗っているタスクの重さの合計 (%)",
            "example": 60
          },
          "isAway": {
            "type": "boolean",
            "description": "最後に画面を開いてから、しきい値 (環境変数 AWAY_THRESHOLD_MINUTES の分数) 以上たっているか"
          },
          "isMe": {
            "type": "boolean"
          }
        },
        "required": [
          "userId",
          "name",
          "image",
          "busy",
          "isAway",
          "isMe"
        ]
      },
      "MemberDetail": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "example": "u_abc"
          },
          "name": {
            "type": "string",
            "example": "Alice"
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "example": "https://example.com/alice.png"
          },
          "busy": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "忙しさ。乗っているタスクの重さの合計 (%)",
            "example": 60
          },
          "isAway": {
            "type": "boolean",
            "description": "最後に画面を開いてから、しきい値 (環境変数 AWAY_THRESHOLD_MINUTES の分数) 以上たっているか"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "description": "気球に乗っているタスク。乗せた日時の新しい順"
          }
        },
        "required": [
          "userId",
          "name",
          "image",
          "busy",
          "isAway",
          "tasks"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/healthz": {
      "get": {
        "tags": [
          "healthz"
        ],
        "operationId": "getHealthz",
        "responses": {
          "200": {
            "description": "API is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Healthz"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "me"
        ],
        "operationId": "getMe",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "ログイン中のユーザーと、今いるルーム",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "ログインしていない (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/tasks": {
      "get": {
        "tags": [
          "me"
        ],
        "operationId": "getMyTasks",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "自分の状態と、乗っているタスクとプールのタスク",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyStatus"
                }
              }
            }
          },
          "401": {
            "description": "ログインしていない (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "me"
        ],
        "operationId": "addMyTask",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewTask"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "プールにタスクを作った後の自分の状態。重さの合計は確かめない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyStatus"
                }
              }
            }
          },
          "400": {
            "description": "入力の形が正しくない (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "ログインしていない (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/tasks/drop": {
      "post": {
        "tags": [
          "me"
        ],
        "operationId": "dropMyTasks",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "乗っているタスクをすべて消した後の自分の状態。プールには戻さない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyStatus"
                }
              }
            }
          },
          "401": {
            "description": "ログインしていない (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/tasks/{taskId}/load": {
      "post": {
        "tags": [
          "me"
        ],
        "operationId": "loadMyTask",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "example": 12
            },
            "required": true,
            "name": "taskId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "プールのタスクを気球に乗せた後の自分の状態",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyStatus"
                }
              }
            }
          },
          "400": {
            "description": "入力の形が正しくない (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "ログインしていない (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "自分のプールにそのタスクがない (TASK_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "重さの合計が 100% を超える (WEIGHT_LIMIT_EXCEEDED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/tasks/{taskId}": {
      "delete": {
        "tags": [
          "me"
        ],
        "operationId": "deleteMyTask",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "example": 12
            },
            "required": true,
            "name": "taskId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "タスクを消した後の自分の状態",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyStatus"
                }
              }
            }
          },
          "400": {
            "description": "入力の形が正しくない (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "ログインしていない (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "自分のタスクにそれがない (TASK_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms": {
      "post": {
        "tags": [
          "rooms"
        ],
        "operationId": "createRoom",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "ルームを作って入った。前のルームにいれば抜ける",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinedRoom"
                }
              }
            }
          },
          "401": {
            "description": "ログインしていない (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "空いているルーム ID が見つからなかった (ROOM_ID_EXHAUSTED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/room": {
      "delete": {
        "tags": [
          "rooms"
        ],
        "operationId": "leaveMyRoom",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "今いるルームから抜けた。ルームに入っていなくても成功にする"
          },
          "401": {
            "description": "ログインしていない (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{roomId}/members": {
      "post": {
        "tags": [
          "rooms"
        ],
        "operationId": "joinRoom",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{6}$",
              "description": "6 桁のルーム ID (000000 から 999999)。先頭の 0 を落とさないよう文字列で持つ",
              "example": "012345"
            },
            "required": true,
            "description": "6 桁のルーム ID (000000 から 999999)。先頭の 0 を落とさないよう文字列で持つ",
            "name": "roomId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "ルームに入った。前のルームにいれば抜ける",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinedRoom"
                }
              }
            }
          },
          "400": {
            "description": "入力の形が正しくない (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "ログインしていない (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "ルームがない (ROOM_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "短い時間に入室を繰り返した (RATE_LIMITED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{roomId}": {
      "get": {
        "tags": [
          "rooms"
        ],
        "operationId": "getRoom",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{6}$",
              "description": "6 桁のルーム ID (000000 から 999999)。先頭の 0 を落とさないよう文字列で持つ",
              "example": "012345"
            },
            "required": true,
            "description": "6 桁のルーム ID (000000 から 999999)。先頭の 0 を落とさないよう文字列で持つ",
            "name": "roomId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "ルームのメンバーと気球の状態。数秒ごとにポーリングされる。呼んだ人が最後に画面を開いていた時刻を今にする",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                }
              }
            }
          },
          "400": {
            "description": "入力の形が正しくない (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "ログインしていない (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "そのルームのメンバーではない (NOT_ROOM_MEMBER)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "ルームがない (ROOM_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{roomId}/members/{userId}": {
      "get": {
        "tags": [
          "rooms"
        ],
        "operationId": "getRoomMember",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{6}$",
              "description": "6 桁のルーム ID (000000 から 999999)。先頭の 0 を落とさないよう文字列で持つ",
              "example": "012345"
            },
            "required": true,
            "description": "6 桁のルーム ID (000000 から 999999)。先頭の 0 を落とさないよう文字列で持つ",
            "name": "roomId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "userId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "気球の詳細。タスクのタイトルを含む",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberDetail"
                }
              }
            }
          },
          "400": {
            "description": "入力の形が正しくない (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
